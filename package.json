{
  "name": "codryn",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend/*",
    "shared",
    "tests/support"
  ],
  "engines": {
    "node": "24.19.0",
    "npm": ">=11 <12"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps backend shared tests scripts --max-warnings=0",
    "check:deps": "depcruise apps backend shared tests/support/src --config dependency-cruiser.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package-r3.mjs",
    "test:r3-desktop": "node scripts/verify-r3-desktop.mjs",
    "test:r3-packaged": "node scripts/verify-packaged-r3.mjs",
    "verify:r3": "node scripts/verify-r3.mjs",
    "make": "npm run make --workspace @codryn/desktop",
    "verify:r0": "node scripts/verify-r0.mjs",
    "verify:r1": "node scripts/verify-r1.mjs",
    "verify:r2": "node scripts/verify-r2.mjs",
    "test:r1-repeatability": "node scripts/verify-r1-repeatability.mjs",
    "test:r2-provider-keys": "node --test scripts/r2-provider-key.test.mjs",
    "test:r2-provider-eval": "node --test scripts/r2-provider-eval-selection.test.mjs",
    "test:r2-live-report": "node --test scripts/r2-live-runner-report.test.mjs",
    "test:r2-repeatability": "node scripts/verify-r2-repeatability.mjs",
    "eval:r2-providers": "node --env-file-if-exists=.env scripts/eval-r2-providers.mjs",
    "verify:r2:live": "node --env-file-if-exists=.env scripts/verify-r2-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.7"
  }
}
